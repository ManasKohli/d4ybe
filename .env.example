# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug
# Comma-separated CORS allowlist (the Vite dev server by default).
ALLOWED_ORIGINS=http://localhost:5173

# Local Supabase (`supabase start`; `supabase status` prints these).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
# Hosted projects: the shared pooler, transaction mode (IPv4, section 2):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ca-central-1.pooler.supabase.com:6543/postgres
# SUPABASE_URL=https://<ref>.supabase.co
# Optional: Supabase root CA (Dashboard → Database → SSL) so the pooler certificate is verified.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Added with Storage and invites (later steps):
# SUPABASE_SECRET_KEY=sb_secret_...
