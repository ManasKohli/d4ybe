{
  "name": "d4ybe",
  "version": "0.1.0",
  "private": true,
  "description": "API for the D4Y Dental Pathway Program (pilot)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ManasKohli/d4ybe.git"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run",
    "test:db": "scripts/test-db.sh",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:types": "supabase gen types typescript --local --schema public > src/db/database.types.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.18",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
